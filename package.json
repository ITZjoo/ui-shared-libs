{
  "name": "ui-shared-libs-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspace @ui-shared-libs/ui",
    "serve": "node scripts/serve.mjs",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\"",
    "size": "node packages/ui/scripts/size.mjs",
    "test:node": "node --test \"tests/node/**/*.test.mjs\"",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test": "npm run build && npm run lint:css && npm run test:node && npm run size && npm run test:e2e && npm run test:storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:storybook": "npm run build-storybook && playwright test --project=storybook"
  },
  "overrides": { "playwright-core": "1.64.1" },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "esbuild": "0.25.5",
    "lightningcss": "1.30.1",
    "storybook": "10.6.3",
    "stylelint": "16.21.0",
    "vite": "7.3.7"
  }
}
